# ============================================================
# Efficio 环境变量示例
#
# 两种用法：
#   1) Docker 部署：复制为项目根目录的 .env，docker-compose 自动读取
#        cp .env.example .env
#   2) 源码部署：复制到 server/ 目录（server/.env.example 已存在）
#        cp server/.env.example server/.env
# ============================================================

# --- 服务器 ---
PORT=3001
NODE_ENV=production
# 日志级别：debug | info | warn | error
LOG_LEVEL=info
# CORS 允许的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:5173

# --- 数据库（默认 SQLite，零配置即可用）---
DATABASE_MODE=sqlite          # memory | sqlite | turso | supabase
SQLITE_DB_PATH=./data/efficiency.db

# Turso（可选）
# TURSO_DATABASE_URL=libsql://your-org-your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# Supabase（可选）
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_KEY=your_supabase_service_key

# --- AI Provider ---
# 任选一个填入 API Key 即可；国内网络推荐 DeepSeek / 智谱 / Kimi / 通义 / 火山。
# 设置 AI_PROVIDER 切换当前使用的 Provider（默认 anthropic）。
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=
# KIMI_API_KEY=
# NVIDIA_API_KEY=
# ALIYUN_API_KEY=
# VOLCENGINE_API_KEY=
# MINIMAX_API_KEY=
# OPENROUTER_API_KEY=
# VLLM_API_KEY=
